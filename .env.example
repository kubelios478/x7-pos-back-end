# .env (Variables de entorno necesarias para el proyecto)
# Copia este archivo a .env y reemplaza los valores. Aquí solo van ejemplos:
# nunca subas credenciales reales a este archivo (está versionado y el repo es público).

# APP
PORT=3000
# 'production' reduce el nivel de logs
NODE_ENV=development
FRONTEND_URL=http://localhost:8081
# Orígenes de navegador permitidos (CORS), separados por coma. Sin definir: cualquiera
CORS_ORIGINS=http://localhost:8081
# Saltos de proxy confiables para la IP del cliente (límite de intentos).
# Sin definir: 1 en producción (Railway), 0 en local
TRUST_PROXY=

# JWT (usa valores largos y aleatorios, p. ej. `openssl rand -hex 32`)
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_largo
JWT_EXPIRES_IN=86400s
# Firma de los enlaces de descarga de contratos (si falta se usa JWT_SECRET)
CONTRACT_DOCUMENT_SECRET=cambia_esto_por_otro_secreto_largo

# DATABASE
DB_HOST=tu_db_host
DB_PORT=5432
DB_USERNAME=tu_db_usuario
DB_PASSWORD=tu_db_password
DB_NAME=tu_db_name
# 'true' para conexiones que exigen SSL (p. ej. Supabase)
DB_SSL=true

# MAIL
# SMTP_ENABLED=false solo registra los correos en el log, sin enviarlos
SMTP_ENABLED=true
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
# 'true' para TLS directo (el puerto 465 lo activa siempre)
SMTP_SECURE=false
SMTP_USER=tu_smtp_usuario
SMTP_PASS=tu_smtp_password
SMTP_FROM='"X7_POS" <no-reply@x7_pos.com>'

# WEBSOCKETS
# WS_ENABLED=false rechaza las conexiones de tiempo real
WS_ENABLED=true
# Orígenes permitidos para WebSocket, separados por coma (vacío = los de CORS_ORIGINS)
WS_CORS_ORIGIN=
# Adaptador Redis para varias instancias (opcional)
WS_REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# CLOVER
CLOVER_CLIENT_ID=tu_client_id
CLOVER_CLIENT_SECRET=tu_client_secret
CLOVER_BASE_URL=https://api.clover.com
CLOVER_REDIRECT_URI=https://yourdomain.com/api/clover/callback

# ONBOARDING
# Plan asignado en POST /auth/register-onboarding cuando el cliente no envía planId
ONBOARDING_DEFAULT_PLAN_ID=1

# SUBSCRIPTION PAYMENTS
# Currency every subscription plan price is expressed in (payment intents are created in it).
SUBSCRIPTION_CURRENCY=USD
# Shared secret for POST /api/subscription-payments/webhook. Without it every call gets 503.
# Signature (generic format until a gateway is integrated):
#   x-signature: sha256=<hex HMAC-SHA256 of the raw body>
#   e.g. printf '%s' "$BODY" | openssl dgst -sha256 -hmac "$SUBSCRIPTION_WEBHOOK_SECRET"
SUBSCRIPTION_WEBHOOK_SECRET=

# DELIVERY WEBHOOKS (POST /api/webhooks/deliveries/:provider, misma firma x-signature)
# Sin secreto, el webhook de ese proveedor responde 503.
DOORDASH_WEBHOOK_SECRET=
UBER_WEBHOOK_SECRET=
